<section class="hero" aria-label="404">
  <h1 class="hero-word">404</h1>
  <canvas class="ascii" data-ascii="404" aria-hidden="true"></canvas>
</section>
<div class="statusbar">
  <div class="wrap">
    <div><span>NOT FOUND</span></div>
    <div><span>链接可能已经失效，或者文章搬了家</span></div>
  </div>
</div>
<div class="wrap">
