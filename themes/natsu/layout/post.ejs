<%
  const cat = natsu_category(page);
  let tocHtml = theme.toc && page.toc !== false ? toc(page.content, { list_number: false, max_depth: 3 }) : '';
  // A table of contents only earns its place with at least two headings.
  if ((tocHtml.match(/<li/g) || []).length < 2) tocHtml = '';
  const older = page.next;
  const newer = page.prev;
%>
<article class="post">
  <header class="page-header">
    <h1 class="page-title"><%= page.title %></h1>
    <p class="meta">
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (cat) { %><a href="<%- url_for(cat.path) %>"><%= cat.name %></a><% } %>
      <span>约 <%= natsu_reading_minutes(page.content) %> 分钟</span>
    </p>
  </header>

  <% if (tocHtml) { %>
    <aside class="post-toc" aria-label="目录">
      <p class="label">目录</p>
      <%- tocHtml %>
    </aside>
    <details class="toc-inline">
      <summary>目录</summary>
      <%- tocHtml %>
    </details>
  <% } %>

  <div class="prose">
    <%- page.content %>
  </div>

  <footer class="post-footer">
    <% if (page.tags && page.tags.length) { %>
      <ul class="tags" aria-label="标签">
        <% page.tags.forEach(tag => { %>
          <li><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <% if (older || newer) { %>
      <nav class="post-nav" aria-label="上一篇 / 下一篇">
        <% if (older) { %>
          <a class="prev" href="<%- url_for(older.path) %>"><small>← 上一篇</small><%= older.title %></a>
        <% } %>
        <% if (newer) { %>
          <a class="next" href="<%- url_for(newer.path) %>"><small>下一篇 →</small><%= newer.title %></a>
        <% } %>
      </nav>
    <% } %>
  </footer>

  <%- partial('_partial/comments') %>
</article>
