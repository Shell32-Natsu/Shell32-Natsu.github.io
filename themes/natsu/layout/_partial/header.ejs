<%
  const current = '/' + (page.path || '').replace(/index\.html$/, '');
  const postCategory = is_post() ? natsu_category(page) : null;
  function isActive(item) {
    if (is_post()) return !!postCategory && natsu_is_excluded(page) && item.path === url_for(postCategory.path);
    return current.startsWith(item.path);
  }
%>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页"><%= config.title.toLowerCase() %><i aria-hidden="true"></i></a>
    <nav class="site-nav" aria-label="主导航">
      <% (theme.menu || []).forEach(item => { %>
        <a href="<%- url_for(item.path) %>"<% if (isActive(item)) { %> aria-current="page"<% } %>><% if (item.short) { %><span class="long"><%= item.name %></span><span class="short"><%= item.short %></span><% } else { %><%= item.name %><% } %></a>
      <% }) %>
    </nav>
    <div class="header-actions">
      <button class="icon-button" type="button" data-search-open aria-label="搜索" title="搜索（/ 或 ⌘K）">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <kbd>/</kbd>
      </button>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换深色 / 浅色" title="切换深色 / 浅色">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
