<%
  const home = theme.home || {};
  const all = page.posts.toArray();
  const lead = all[0];
  const leadCat = lead && natsu_category(lead);
%>
<section class="hero" aria-label="<%= config.title %>">
  <h1 class="hero-word"><%= config.title %></h1>
  <canvas class="ascii" data-ascii="<%= config.title.toUpperCase() %>" aria-hidden="true"></canvas>
</section>
<div class="statusbar">
  <div class="wrap">
    <div><span><%= (config.subtitle || '').toUpperCase().split('/').join(' / ') %></span></div>
    <div>
      <span><b><%= site.posts.length %></b> 篇</span><span class="wide"><b><%= site.tags.length %></b> 标签</span><span><%= theme.since %> — <%= date(Date.now(), 'YYYY') %></span>
    </div>
  </div>
</div>

<div class="wrap">
  <% if (lead) { %>
  <section class="band" aria-labelledby="latest">
    <h2 class="band-side label" id="latest">最新</h2>
    <article class="lead">
      <h3 class="lead-title"><a href="<%- url_for(lead.path) %>" data-morph><%= lead.title %></a></h3>
      <p class="lead-excerpt"><%= natsu_excerpt(lead, 160) %></p>
      <p class="meta">
        <time datetime="<%= date_xml(lead.date) %>"><%= date(lead.date, 'YYYY-MM-DD') %></time>
        <% if (leadCat) { %><span><%= leadCat.name %></span><% } %>
        <span>约 <%= natsu_reading_minutes(lead.content) %> 分钟</span>
        <span>阅读 <i>→</i></span>
      </p>
    </article>
  </section>
  <% } %>

  <%- partial('_partial/post-list', { posts: all.slice(1), showCategory: true }) %>

  <% if ((home.collections || []).length) { %>
  <section class="band" aria-labelledby="collections">
    <h2 class="band-side label" id="collections">专栏</h2>
    <ul class="tiles">
      <% home.collections.forEach(c => {
        const cat = c.category ? site.categories.findOne({ name: c.category }) : null;
      %>
        <li><a class="tile" href="<%- cat ? url_for(cat.path) : url_for(c.path) %>">
          <% if (cat) { %><span class="tile-count"><%= cat.length %></span><% } %>
          <span class="tile-name"><%= c.name %></span>
          <% if (c.desc) { %><span class="tile-desc"><%= c.desc %></span><% } %>
        </a></li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</div>
