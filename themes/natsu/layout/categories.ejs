<% const cats = site.categories.sort('-length').filter(c => c.length); %>
<header class="page-header">
  <p class="kicker">分类</p>
  <h1 class="page-title">所有分类</h1>
  <p class="meta"><span>共 <%= cats.length %> 个</span></p>
</header>
<ul class="links">
  <% cats.forEach(cat => { const latest = cat.posts.sort('-date').first(); %>
    <li><a href="<%- url_for(cat.path) %>">
      <span class="links-name"><%= cat.name %></span>
      <% if (latest) { %><span class="links-desc">最近：<%= latest.title %></span><% } %>
      <span class="links-count"><%= cat.length %> 篇 →</span>
    </a></li>
  <% }) %>
</ul>
