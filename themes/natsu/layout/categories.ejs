<% const cats = site.categories.sort('-length').filter(c => c.length); %>
<header class="page-header">
  <p class="kicker">分类</p>
  <h1 class="page-title">所有分类</h1>
  <p class="meta"><span>共 <%= cats.length %> 个</span></p>
</header>
<ul class="tiles">
  <% cats.forEach(cat => { const latest = cat.posts.sort('-date').first(); %>
    <li><a class="tile" href="<%- url_for(cat.path) %>">
      <span class="tile-count"><%= cat.length %></span>
      <span class="tile-name"><%= cat.name %></span>
      <% if (latest) { %><span class="tile-desc">最近：<%= latest.title %></span><% } %>
    </a></li>
  <% }) %>
</ul>
